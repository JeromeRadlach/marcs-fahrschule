# Email configuration for contact form backend
# Required when running the server locally: npm run dev:full
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# Where contact form submissions are delivered
RECIPIENT_EMAIL=destination@example.com

# Rate limiting for the contact form, per IP
# Defaults to 5 requests per 15 minutes (900000 ms) when unset
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=5

# Port for the contact form backend (default: 3001)
PORT=3001

# Number of reverse proxies in front of this server. Leave unset when running
# the API directly, including local development - trusting X-Forwarded-For on a
# directly reachable server lets anyone forge their IP and bypass the rate
# limit above. Set to 1 when serving behind the nginx block in
# deploy/nginx.conf.
# TRUST_PROXY=1
